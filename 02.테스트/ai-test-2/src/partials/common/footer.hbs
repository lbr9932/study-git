<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__copy">© {{site.title}}</p>
    {{#if navigation.footer}}
      <nav class="site-footer__nav" aria-label="Secondary">
        {{#each navigation.footer}}
          <a class="site-footer__link" href="{{href}}">{{label}}</a>
        {{/each}}
      </nav>
    {{/if}}
  </div>
</footer>
