<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__copy">© {{site.title}}</p>
    <nav class="site-footer__nav" aria-label="Secondary">
      {{#each navigation.footer}}
        <a class="site-footer__link" href="{{siteHref ../currentPath href}}">{{label}}</a>
      {{/each}}
    </nav>
  </div>
</footer>
