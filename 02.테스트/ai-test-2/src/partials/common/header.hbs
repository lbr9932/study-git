<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="{{siteHref currentPath '/'}}" aria-label="{{site.title}} home">
      <span class="brand__mark">DN</span>
      <span class="brand__text">{{site.title}}</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {{#each navigation.header}}
        <a class="site-nav__link" href="{{siteHref ../currentPath href}}">{{label}}</a>
      {{/each}}
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
      <span class="theme-toggle__label">Theme</span>
    </button>
  </div>
</header>
