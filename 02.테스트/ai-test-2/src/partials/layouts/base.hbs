<!doctype html>
<html lang="{{locale}}" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{#if title}}{{title}} | {{site.title}}{{else}}{{site.title}}{{/if}}</title>
    <meta name="description" content="{{description}}" />
    <link rel="canonical" href="{{site.url}}{{canonical}}" />
    <meta property="og:type" content="{{#if ogType}}{{ogType}}{{else}}website{{/if}}" />
    <meta property="og:title" content="{{#if title}}{{title}}{{else}}{{site.title}}{{/if}}" />
    <meta property="og:description" content="{{description}}" />
    <meta property="og:url" content="{{site.url}}{{canonical}}" />
    <meta property="og:site_name" content="{{site.title}}" />
    <meta name="twitter:card" content="summary_large_image" />
    {{> style}}
  </head>
  <body class="{{bodyClass}}">
    {{#unless landing}}
      {{> common/header}}
    {{/unless}}
    <main id="content" class="{{#if landing}}landing-shell{{else}}page-shell{{/if}}">
      {{> @partial-block }}
    </main>
    {{#unless landing}}
      {{> common/footer}}
    {{/unless}}
    <script type="module" src="{{resolve-from-root '../scripts/main.js'}}"></script>
    {{> script}}
  </body>
  </html>
