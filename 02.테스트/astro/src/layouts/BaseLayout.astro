---
import "../styles/global.css";

const { lang, title = "Astro Sample" } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <main class="page">
      <slot />
    </main>
  </body>
</html>
